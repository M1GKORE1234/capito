{
  "name": "capito",
  "version": "1.0.0",
  "description": "Measure and pay down comprehension debt in AI-written code. Questions whose answers are verified by running your tests, a comprehension map of your repo, and a weekly 5-minute review.",
  "license": "MIT",
  "author": "Alessio Kore (https://github.com/M1GKORE1234)",
  "repository": {
    "type": "git",
    "url": "https://github.com/M1GKORE1234/capito.git"
  },
  "homepage": "https://github.com/M1GKORE1234/capito#readme",
  "keywords": [
    "github-action",
    "ai",
    "comprehension-debt",
    "mutation-testing",
    "code-review",
    "learning",
    "ai-generated-code"
  ],
  "bin": {
    "capito": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "README.it.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
